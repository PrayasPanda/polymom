# --- Application ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# --- ML providers (never commit real values) ---
# Hugging Face token; required for pyannote diarization and the Odia ASR model
# (both are gated: accept their terms on huggingface.co first)
HF_TOKEN=

# --- LLM summarization ---
# openai | azure | anthropic | ollama (fully local) | mock (offline, deterministic)
LLM_PROVIDER=openai
# Empty = provider default: gpt-4o-mini, claude-sonnet-5, qwen2.5:7b-instruct
LLM_MODEL=
LLM_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
# Repair attempts for invalid JSON, and retries on 429/5xx (exponential backoff)
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=120
# USD per 1M tokens, for cost tracking (0 = not tracked)
LLM_INPUT_COST_PER_MTOK=0
LLM_OUTPUT_COST_PER_MTOK=0
# en | hi | or  (evidence quotes always stay in the original language)
SUMMARY_OUTPUT_LANGUAGE=en
# Transcripts above this estimate use map-reduce with chunks of SUMMARY_CHUNK_TOKENS
SUMMARY_SINGLE_PASS_TOKENS=12000
SUMMARY_CHUNK_TOKENS=6000
# rapidfuzz partial_ratio (0-100) an evidence quote needs against its utterance
EVIDENCE_MATCH_THRESHOLD=80
# Langfuse tracing (uv sync --extra tracing)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Storage / database ---
STORAGE_DIR=./storage
# Leave empty for SQLite at STORAGE_DIR/polymom.db.
# Postgres example: postgresql+asyncpg://user:pass@localhost:5432/polymom
DATABASE_URL=
# Run Alembic migrations on startup
AUTO_MIGRATE=true

# --- Artifact storage (uploads, processed audio, charts, exports) ---
# local (files under STORAGE_DIR) | s3 (AWS S3 or MinIO; uv sync --extra s3)
ARTIFACT_STORE=local
S3_BUCKET=polymom
# MinIO: http://minio:9000 (docker compose --profile minio); empty for AWS S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Stage outputs larger than this are stored as artifacts instead of in the DB
STAGE_OUTPUT_INLINE_MAX_BYTES=524288

# --- Retention (scripts/cleanup.py --apply) ---
# Purge raw audio of meetings older than this; results are kept. 0 = never
RETENTION_DAYS=90
KEEP_RAW_AUDIO=false

# --- Uploads ---
MAX_UPLOAD_MB=200
ALLOWED_EXTENSIONS=wav,mp3,m4a,flac,ogg,aac,mp4,mkv,mov,webm
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30

# --- Preprocessing ---
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
TARGET_SAMPLE_RATE=16000
TARGET_LOUDNESS_LUFS=-23
ENABLE_HIGHPASS=true
HIGHPASS_CUTOFF_HZ=80
ENABLE_DENOISE=false
TRIM_SILENCE=false
SILENCE_THRESHOLD_DB=-50
SILENCE_MIN_DURATION_SECONDS=0.5

# --- Chunking (long recordings) ---
CHUNK_LENGTH_SECONDS=1800
CHUNK_OVERLAP_SECONDS=5

# --- Diarization ---
# pyannote (needs `uv sync --extra ml` + HF_TOKEN) | mock (deterministic fake, no ML)
DIARIZATION_BACKEND=pyannote
# auto | cpu | cuda
DEVICE=auto
MERGE_GAP_SECONDS=0.5
MIN_TURN_SECONDS=0.3
# Recordings longer than this are diarized in CHUNK_LENGTH_SECONDS chunks and re-linked
DIARIZATION_CHUNK_THRESHOLD_SECONDS=3600
# Cosine similarity needed to treat speakers in different chunks as the same person
SPEAKER_SIMILARITY_THRESHOLD=0.6

# --- Speech recognition ---
# real (faster-whisper + IndicConformer) | mock (scripted en/hi/or lines, no ML)
ASR_BACKEND=real
# tiny | base | small | medium | large-v3 ...
WHISPER_MODEL_SIZE=large-v3
# auto (float16 on GPU, int8 on CPU) | int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
ODIA_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# rnnt (more accurate) | ctc (faster)
ODIA_DECODING=rnnt
# language:backend routing; backends: whisper, indic
ASR_LANGUAGE_BACKENDS=en:whisper,hi:whisper,or:indic
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
# Segments with average word confidence below this are flagged low_confidence
ASR_LOW_CONFIDENCE_THRESHOLD=0.5
# Hallucination guards
ASR_COMPRESSION_RATIO_THRESHOLD=2.4
ASR_NO_SPEECH_THRESHOLD=0.6

# --- Spoken language ID and code-switching ---
SUPPORTED_LANGUAGES=en,hi,or
# Route each language region to its ASR backend (false = single-pass Prompt 5 behaviour)
LANGUAGE_ROUTING_ENABLED=true
# mms (en/hi/or, CC-BY-NC-4.0) | speechbrain (en/hi, Apache-2.0) | whisper (en/hi) | mock
LID_BACKEND=mms
LID_MODEL_ID=facebook/mms-lid-126
LID_MIN_CONFIDENCE=0.5
LID_MIN_WINDOW_SECONDS=1.5
LID_MAX_WINDOW_SECONDS=15

# --- Speaker / transcript alignment ---
# Words overlapping no turn go to the nearest turn within this gap, else "Unknown"
ALIGN_MAX_GAP_SECONDS=1.0
# Fragments shorter than UTTERANCE_MIN_WORDS merge into the same speaker within this gap
ALIGN_MERGE_GAP_SECONDS=1.0
# Longer utterances are split at sentence punctuation (. ? ! । ॥)
UTTERANCE_MAX_SECONDS=30
UTTERANCE_MIN_WORDS=2

# --- Speaker analytics ---
# A turn starting inside another speaker's turn is an interruption above this overlap
INTERRUPTION_MIN_OVERLAP_SECONDS=0.5
# Timeline window for per-speaker speaking time
BUCKET_SECONDS=60
# Gini of speaking time: <= balanced max is "balanced", >= dominated min is "dominated"
GINI_BALANCED_MAX=0.2
GINI_DOMINATED_MIN=0.4
