# --- Application ---
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# --- ML providers (never commit real values) ---
HF_TOKEN=
# openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_API_KEY=

# --- Storage / uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=200
ALLOWED_EXTENSIONS=wav,mp3,m4a,flac,ogg,webm,mp4
